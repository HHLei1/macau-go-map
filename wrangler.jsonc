{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "green-go-macau",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "green-go-macau-db",
      "database_id": "a48703df-9336-47a6-b536-ef00555d47d1",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "6f219993911a4d598390f9cec7b1746b"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
