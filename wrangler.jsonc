{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macau-go-map",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/admin"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "macau-go-map-db",
      "database_id": "b098f25d-69b0-4cd4-b8e6-9b154ec468b1",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "945fcffc220d4e2fba4a01fcc1710018"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
